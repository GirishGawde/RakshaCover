{
  "manifest_version": 3,
  "name": "RakshaCover Link Shield",
  "version": "0.1.0",
  "description": "Explains link risk before you enter sensitive information.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Check this page with RakshaCover",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/page-scanner.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html"
}